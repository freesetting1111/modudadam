FRONTEND_URL=http://localhost:3005
DATABASE_URL="postgresql://postgres:1234@localhost:5432/postgres"
APP_NAME=modudadam-backend
LOCAL_AUTH_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3005/api/auth/oauth/kakao/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3005/api/auth/oauth/naver/callback
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3005
OAUTH_FAILURE_REDIRECT_URL=http://localhost:3005/login
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="모두다담 <no-reply@example.com>"
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=modudadam-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# CloudFront를 연결한 뒤에만 설정합니다. 비워두면 1시간 유효한 S3 조회 URL을 사용합니다.
AWS_S3_PUBLIC_BASE_URL=
MODUDADAM_EVENT_URL=http://localhost:3006
# frontend와 backend 프로젝트에 동일한 32바이트 이상의 임의 문자열을 설정하세요.
EVENT_GATEWAY_SHARED_SECRET=
